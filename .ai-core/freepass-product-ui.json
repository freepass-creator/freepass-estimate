{
  "contract": "freepass-product-ui-profile-binding/v1",
  "version": "1.1.0",
  "ai_core": {
    "repository": "freepass-creator/ai-core",
    "revision": "01e6bb7e0cd08e6390b452892516fd204ed64090",
    "authorities": [
      "docs/SCREEN_DESIGN_STANDARD.md",
      "docs/FREEPASS_PRODUCT_UI_PROFILE.md",
      "docs/UI_UX_CONSTITUTION.md",
      "design-system/interaction.contract.json"
    ]
  },
  "product": "FreePass",
  "surfaces": [
    "sales-app",
    "promotion",
    "self-quote"
  ],
  "visual": {
    "font": "Pretendard Variable",
    "background": "#f7f8fa",
    "surface": "#ffffff",
    "text": "#212529",
    "textSecondary": "#5c6268",
    "line": "#eceef0",
    "lineStrong": "#d9dde1",
    "cardRadiusPx": 12,
    "controlRadiusPx": 10,
    "minTouchPx": 44,
    "defaultTheme": {
      "id": "freepass",
      "primary": "#1b2a4a",
      "strong": "#0f1b35",
      "soft": "#e6ecf5"
    }
  },
  "interaction": {
    "topIsInformationBottomIsAction": true,
    "singleChoiceAutoAdvance": true,
    "choiceCommitMs": 160,
    "stepEntryMs": 160,
    "pressedMinHoldMs": 72,
    "pressScale": 0.965,
    "hapticsMs": {
      "subtle": 7,
      "selection": 12,
      "primary": 18
    },
    "reducedMotion": true,
    "scrollOwner": "single bounded content region",
    "selectedState": "soft-surface + text-weight, not color-only"
  },
  "exceptions": {
    "partnerAccent": "Co-brand/partner identity may override brand primary/strong/soft and logo through a declared theme; semantic state colors and interaction grammar remain invariant."
  },
  "adoption_status": "MAPPED_PENDING_RENDERED_RECEIPT",
  "themePolicy": {
    "modes": [
      "freepass",
      "cobrand",
      "white-label"
    ],
    "overridable": [
      "brand.primary",
      "brand.strong",
      "brand.soft",
      "logo",
      "wordmark",
      "partnerAccent"
    ],
    "invariant": [
      "semantic.success",
      "semantic.warning",
      "semantic.danger",
      "semantic.focus",
      "semantic.disabled",
      "typography",
      "spacing",
      "radius",
      "touch-target",
      "interaction-state-semantics",
      "haptic-motion-contract"
    ],
    "themes": {
      "freepass": {
        "primary": "#1b2a4a",
        "strong": "#0f1b35",
        "soft": "#e6ecf5"
      },
      "welrix": {
        "primary": "#c81e2a",
        "strong": "#a3131d",
        "soft": "#fdecee"
      },
      "welrix-trust": {
        "primary": "#1b2a4a",
        "strong": "#0f1b35",
        "soft": "#e6ecf5",
        "partnerAccent": "#c81e2a"
      }
    },
    "rule": "Brand colors may change by product/partner/white-label theme; semantic state meanings and component behavior may not.",
    "customerFacingDefault": "welrix-trust"
  },
  "brandThemeRegistry": {
    "repository": "freepass-creator/ai-core",
    "revision": "30e16079233112cd77bbb0f56476374672555c20",
    "branch": "feat/freepass-suite-ui-consumers-20260921",
    "path": "design-system/brand-themes.registry.json",
    "status": "CANDIDATE"
  },
  "alignmentPolicy": {
    "start": [
      "page-title",
      "section-title",
      "choice-row",
      "trim",
      "option",
      "field-label",
      "helper",
      "card-narrative"
    ],
    "center": [
      "manufacturer-grid",
      "color-swatch-grid",
      "short-chip",
      "period-compare-tile",
      "cta-label"
    ],
    "end": [
      "money",
      "percentage",
      "quantity",
      "total",
      "definition-value",
      "numeric-table-value"
    ],
    "invariant": "Font weight does not determine alignment. Choice rows share one start edge; numeric values use a stable end edge."
  },
  "trustEmphasisPolicy": {
    "brandPrimary": [
      "primary-cta",
      "selected-state",
      "progress",
      "active-navigation",
      "key-result"
    ],
    "neutral": [
      "list-price",
      "option-price-unselected",
      "body-copy",
      "supporting-value"
    ],
    "partnerAccent": [
      "partner-name",
      "partner-logo",
      "co-brand-label"
    ],
    "rule": "Brand color is a limited emphasis resource. Unselected monetary values stay neutral; selected/key-result values may use brand primary."
  },
  "publicShellPolicy": {
    "customerSurfaces": [
      "promotion",
      "self-quote"
    ],
    "horizontalGutterPx": 16,
    "primaryActionHeightPx": 52,
    "cardRadiusPx": 12,
    "controlRadiusPx": 10,
    "rule": "Promotion and Self Quote share edge rhythm, control height and card geometry; internal Sales App may use denser operational metrics."
  },
  "vehicleSelectionPolicy": {
    "flow": [
      "manufacturer",
      "model",
      "powertrain(engine+seat/drive)",
      "trim",
      "colors",
      "options"
    ],
    "separatePassengerDriveStep": false,
    "storage": "variant + trimGroup",
    "rule": "Passenger/drive/use axes are folded into the powertrain choice when they split real product combinations; selecting one choice advances directly to trim."
  }
}
