# FreePass Data server-to-server boundary (server-only)
FREEPASS_DATA_CONSUMER_BASE_URL=https://<freepass-data-consumer-host>
FREEPASS_DATA_WRITE_BASE_URL=https://<freepass-data-estimate-writer-host>
FREEPASS_DATA_ESTIMATE_TOKEN=<server-only-service-token>
FREEPASS_DATA_GCP_WIF_AUDIENCE=//iam.googleapis.com/projects/<project-number>/locations/global/workloadIdentityPools/vercel/providers/<provider>
FREEPASS_DATA_GCP_CALLER_SERVICE_ACCOUNT_EMAIL=<caller-service-account>
FREEPASS_DATA_REQUIRE_CLOUD_RUN_ID_TOKEN=true
FREEPASS_DATA_CLOUD_RUN_IDENTITY_TIMEOUT_MS=5000

# Optional explicit persistence endpoints. Leave blank to derive from CONSUMER_BASE_URL.
FREEPASS_DATA_QUOTE_COMMAND_URL=
FREEPASS_DATA_QUOTE_READ_BASE_URL=
FREEPASS_DATA_SHARE_ENVELOPE_COMMAND_URL=
FREEPASS_DATA_SHARE_ENVELOPE_READ_BASE_URL=

# Firebase ID-token verification for Estimate write APIs
FREEPASS_FIREBASE_PROJECT_ID=<firebase-project-id>
FREEPASS_ESTIMATE_ALLOW_ANONYMOUS_WRITES=false
FREEPASS_ESTIMATE_REQUIRED_WRITE_ROLES=agent,admin
FREEPASS_ESTIMATE_ALLOWED_WRITE_UIDS=

# Browser-visible UI configuration
# IMPORTANT: VITE_AGENT_PIN is embedded into client HTML. It is an UX gate, NOT authentication.
VITE_AGENT_PIN=<choose-ui-gate-pin>

# New legacy RTDB Quote writes are forbidden for deploys.
VITE_FREEPASS_QUOTE_WRITE_MODE=CANONICAL_ONLY
